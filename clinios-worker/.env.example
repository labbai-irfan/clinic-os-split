# ========== CliniOS Worker ==========
# Consumes background jobs enqueued by clinios-api via Redis.

NODE_ENV=development

# Database — must point at the same database as clinios-api
MONGODB_URI=mongodb://127.0.0.1:27017/clinicos

# Redis — required. Without it the worker logs a warning and idles.
# Must match clinios-api REDIS_URL or jobs will never be picked up.
REDIS_URL=redis://127.0.0.1:6379

# Twilio (optional) — SMS/WhatsApp appointment reminders
# Leave blank to skip; reminders are logged and dropped, everything else still works
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# sms | whatsapp — which channel to send appointment reminders through
APPOINTMENT_REMINDER_CHANNEL=sms
